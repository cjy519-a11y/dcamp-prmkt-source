server {
    listen $PORT;
    listen [::]:$PORT;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 헬스체크
    location = / {
        try_files /index.html =200;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Apps Script CORS 프록시
    location /api/gs {
        proxy_pass https://script.google.com/macros/s/AKfycbzzGuFGscXV2R5M3vHHfo6sxcFSCRB74uBxtKIB9ggQRlqrdLz3zYA7KroCO4MnJ3WOUQ/exec;
        proxy_ssl_server_name on;
        proxy_set_header Host script.google.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # CORS 헤더
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json;
}
